# Data - Ignore raw logs and heavy intermediate files
data/results/raw/
data/results/details/

# Ignore raw chat logs containing privacy
data/output_samples/raw_chat_logs*

# Allow summary CSVs and Samples (ホワイトリスト方式)
!data/results/summary/
